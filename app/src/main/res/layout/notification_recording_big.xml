<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_record_brand" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/notif_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_deep"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_notif_dark"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_notif_pause" />

        <ImageButton
            android:id="@+id/notif_stop"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_notif_stop"
            android:contentDescription="@string/stop"
            android:src="@drawable/ic_notif_stop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/mic_volume"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_vol_down"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_btn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notif_mic_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_deep"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_vol_up"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_notif_btn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/ink"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
