<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <id.rekaminaja.app.ui.RekTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rekTitle="@string/censor_zones" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:elevation="1dp"
        android:padding="14dp"
        android:text="@string/censor_instructions"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/previewArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_preview_screen"
        android:elevation="1dp">

        <View
            android:layout_width="110dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="18dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_mock_line" />

        <View
            android:layout_width="180dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="18dp"
            android:layout_marginTop="56dp"
            android:background="@drawable/bg_mock_line" />

        <View
            android:layout_width="140dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="18dp"
            android:layout_marginTop="78dp"
            android:background="@drawable/bg_mock_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/top_of_screen"
            android:textColor="#8A94A3"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/bottom_of_screen"
            android:textColor="#8A94A3"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <id.rekaminaja.app.ui.RekPillButton
            android:id="@+id/btnAddZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:rekIcon="@drawable/ic_plus"
            app:rekText="@string/add_zone"
            app:rekVariant="outline" />

        <id.rekaminaja.app.ui.RekPillButton
            android:id="@+id/btnDeleteZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            app:rekIcon="@drawable/ic_trash"
            app:rekText="@string/delete_zone"
            app:rekVariant="dangerSoft" />

        <id.rekaminaja.app.ui.RekPillButton
            android:id="@+id/btnSaveZones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            app:rekIcon="@drawable/ic_check"
            app:rekText="@string/save"
            app:rekVariant="primary" />
    </LinearLayout>
</LinearLayout>
