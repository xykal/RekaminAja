<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="RekPillButton">
        <attr name="rekText" format="string" />
        <attr name="rekIcon" format="reference" />
        <attr name="rekVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="soft" value="1" />
            <enum name="outline" value="2" />
            <enum name="dark" value="3" />
            <enum name="dangerSoft" value="4" />
        </attr>
    </declare-styleable>

    <declare-styleable name="RekChoiceView">
        <attr name="rekLabel" format="string" />
    </declare-styleable>

    <declare-styleable name="RekTopBar">
        <attr name="rekTitle" format="string" />
        <attr name="rekSubtitle" format="string" />
    </declare-styleable>
</resources>
