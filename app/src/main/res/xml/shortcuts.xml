        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="id.rekaminaja.app.MainActivity"
            android:targetPackage="id.rekaminaja.app">
            <extra android:name="auto" android:value="screenshot" />
        </intent>
    </shortcut>
